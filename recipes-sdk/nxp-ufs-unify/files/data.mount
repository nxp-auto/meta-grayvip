[Unit]
Description=Mount UFS Logical Volume to /data
ConditionPathExists=/data
Requires=prepare-ufs.service dev-mapper-vg_data\x2dlv_data.device
After=prepare-ufs.service dev-mapper-vg_data\x2dlv_data.device

[Mount]
What=/dev/mapper/vg_data-lv_data
Where=/data
Type=ext4
Options=defaults

[Install]
WantedBy=multi-user.target